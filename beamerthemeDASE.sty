% The official DASE mark is rasterised from assets/DASE.svg into the bundled
% assets/DASE.png so both pdfLaTeX and LuaLaTeX can use it without shell escape.
\newcommand{\dasebadge}{\includegraphics[width=.24\paperwidth]{assets/DASE.png}}
% Replace this image to brand the deck for a lab or team.  Use a PNG with an
% alpha channel (RGBA), or a PDF without a filled background. Export SVG to
% PNG/PDF first; JPEG cannot store transparency. The slot matches the DASE mark.
\newcommand{\daselablogofile}{assets/lab-logo.png}
\newsavebox{\dase@badgebox}
\newcommand{\daselablogo}{%
  \begingroup
  \sbox{\dase@badgebox}{\dasebadge}%
  \vbox to\dimexpr\ht\dase@badgebox+\dp\dase@badgebox\relax{%
    \vfil
    \hbox to\wd\dase@badgebox{%
      \hfil\includegraphics[width=\wd\dase@badgebox,
        height=\dimexpr\ht\dase@badgebox+\dp\dase@badgebox\relax,
        keepaspectratio]{\daselablogofile}\hfil}%
    \vfil}%
  \endgroup}
\newcommand{\dasebranding}{%
  \node[anchor=north west] (dasebrand) at
    ([xshift=.48cm,yshift=-.48cm]current page.north west) {\dasebadge};
  \node[anchor=north west] at
    ([yshift=-.22cm]dasebrand.south west) {\daselablogo};}
\newcommand{\dasewatermark}{\includegraphics[height=.70\paperheight]{assets/HKU_crest_bw.png}}
\newcommand{\dasewatermarklight}{\includegraphics[height=.70\paperheight]{assets/HKU_crest_white.png}}
% One shared geometric chevron for all opening, section, and closing pages.
% The left-pointing apex sits at 72% of the page height.
\newcommand{\dasepanel}[2]{%
  \path[use as bounding box] (current page.north west) rectangle (current page.south east);
  % Extend the divider a fraction beyond the page so the orange stroke is
  % clipped at the frame edge rather than ending with a visible gap.
  \coordinate (daseTop) at ([xshift=.40\paperwidth,yshift=.08cm]current page.north west);
  \coordinate (daseTip) at ([xshift=.18\paperwidth,yshift=-.72\paperheight]current page.north west);
  \coordinate (daseBottom) at ([xshift=.40\paperwidth,yshift=-.08cm]current page.south west);
  \fill[#1] (current page.north west) rectangle (current page.south east);
  \fill[#2] (daseTop) -- (daseTip) -- (daseBottom)
    -- (current page.south east) -- (current page.north east) -- cycle;
  \draw[DASEorange,line width=3.5pt,line cap=butt,line join=miter]
    (daseTop) -- (daseTip) -- (daseBottom);}
\newcommand{\dasecover}{\dasepanel{DASEmist}{DASEpurple}}
\newcommand{\dasesectionbackground}{\dasepanel{DASEmist}{DASEpaper}}

% Shared bounds for theme-owned text.  Truncate at character boundaries;
% clipping is a fallback for indivisible objects such as long inline formulas.
\newbox\dase@labelbox
\newbox\dase@markerbox
\newbox\dase@truncatebox
\newbox\dase@textblock
\newbox\dase@splitbox
\newbox\dase@linebox
\newbox\dase@scratchbox
\newdimen\dase@labelwidth
\newdimen\dase@prefixwidth
\newcount\dase@linesleft
\newcommand{\daseellipsis}[2]{%
  \leavevmode
  \begingroup
  \let\\\space
  \setbox\dase@labelbox=\hbox{#2}%
  \ifdim\wd\dase@labelbox>#1\relax
    \dase@forceellipsis{#1}{#2}%
  \else\box\dase@labelbox\fi
  \endgroup}
\newcommand{\dase@forceellipsis}[2]{%
  \begingroup
  \let\\\space
  \hbadness=10000\hfuzz=\maxdimen
  \dase@labelwidth=#1\relax
  \setbox\dase@markerbox=\hbox{\textellipsis}%
  \advance\dase@labelwidth by -\wd\dase@markerbox
  \setbox\dase@truncatebox=\hbox{\truncate[]{\dase@labelwidth}{#2}}%
  \dase@prefixwidth=\wd\dase@truncatebox
  \ifdim\dase@prefixwidth>\dase@labelwidth
    \dase@prefixwidth=\dase@labelwidth
  \fi
  \tikz[baseline=0pt]{%
    \path[use as bounding box] (0,-\dp\dase@truncatebox)
      rectangle (\dase@prefixwidth,\ht\dase@truncatebox);
    \begin{scope}
      \clip (0,-\dp\dase@truncatebox-.1pt)
        rectangle (\dase@prefixwidth,\ht\dase@truncatebox+.1pt);
      \node[anchor=base west,inner sep=0pt,outer sep=0pt] at (0,0)
        {\box\dase@truncatebox};
    \end{scope}}%
  \box\dase@markerbox
  \endgroup}
% Keep at most the requested number of lines, marking the final visible line
% when more text follows.  Normal manual line breaks remain available.
\newcommand{\dase@boundedline}{%
  \daseellipsis{\hsize}{\unhcopy\dase@linebox\unskip\unskip}}
\newcommand{\daseboundedtext}[3][2]{%
  \begingroup
  \hsize=#2\relax\linewidth=\hsize
  \parindent=0pt\parskip=0pt
  \hyphenpenalty=10000\exhyphenpenalty=10000
  \hbadness=10000\hfuzz=\maxdimen
  \vbadness=10000\vfuzz=\maxdimen
  \splittopskip=\baselineskip\splitmaxdepth=\maxdimen
  \setbox\dase@textblock=\vbox{\raggedright\noindent#3\par}%
  \dase@linesleft=#1\relax
  \vbox{%
    \loop
      \setbox\dase@splitbox=\vsplit\dase@textblock to\baselineskip
      \setbox\dase@scratchbox=\vbox{%
        \unvbox\dase@splitbox\unskip\unpenalty
        \global\setbox\dase@linebox=\lastbox}%
      \hbox to\hsize{%
        \ifnum\dase@linesleft=1
          \ifvoid\dase@textblock
            \dase@boundedline
          \else
            \dase@forceellipsis{\hsize}{\unhcopy\dase@linebox\unskip\unskip}%
          \fi
        \else
          \dase@boundedline
        \fi\hfil}%
      \advance\dase@linesleft by -1\relax
      \ifvoid\dase@textblock\dase@linesleft=0\relax\fi
    \ifnum\dase@linesleft>0\repeat}%
  \endgroup}
% Retain TeX's fitted interword spacing on chapter lines.  Reboxing a line
% at its natural width can otherwise remove words that already fit after
% TeX shrinks the spaces.  Only the eighth line may acquire an ellipsis.
\newcommand{\dasechaptertext}[2]{%
  \begingroup
  \renewcommand{\dase@boundedline}{\box\dase@linebox}%
  \daseboundedtext[8]{#1}{#2}%
  \endgroup}

\defbeamertemplate*{frametitle}{DASE}{%
  \nointerlineskip
  \begin{beamercolorbox}[wd=\textwidth,ht=1.36cm,dp=0.28cm,leftskip=0.78cm,rightskip=0.78cm]{frametitle}
    \usebeamerfont{frametitle}\daseellipsis{\dimexpr\textwidth-1.56cm\relax}{\insertframetitle}\par
    \ifx\insertframesubtitle\@empty\else
      {\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\daseellipsis{\dimexpr\textwidth-1.56cm\relax}{\insertframesubtitle}\par}
    \fi
  \end{beamercolorbox}%
  \begin{beamercolorbox}[wd=\textwidth,ht=0.055cm,dp=0pt]{structure}\end{beamercolorbox}\par
}

\newcommand{\dase@boundblocktitle}{%
  \let\dase@originalblocktitle\insertblocktitle
  \def\insertblocktitle{%
    \daseellipsis{\dimexpr\linewidth-2ex\relax}{\dase@originalblocktitle}}}
\addtobeamertemplate{block begin}{\dase@boundblocktitle}{}
\addtobeamertemplate{block alerted begin}{\dase@boundblocktitle}{}
\addtobeamertemplate{block example begin}{\dase@boundblocktitle}{}

% Record content frames in the auxiliary file: plain pages and unnumbered
% frames are omitted, and multiple overlays share one dot.  A separate
% chapter identifier also distinguishes starred sections such as References.
\newcount\dase@chapter
\newcount\dase@lastframe
\newcount\dase@current
\newsavebox{\dase@dotsbox}
\def\dase@entries{}
\AddToHook{cmd/section/before}{\global\advance\dase@chapter by 1\relax}
\newcommand{\daseprogressentry}[3]{%
  \g@addto@macro\dase@entries{\dase@entry{#1}{#2}{#3}}}
\AtBeginEnvironment{beamer@frameslide}{%
  \ifbeamer@plainframe\else
    \ifbeamer@noframenumbering\else
      \ifnum\c@framenumber>\dase@lastframe
        \global\dase@lastframe=\c@framenumber
        \immediate\write\@auxout{%
          \string\daseprogressentry{\the\dase@chapter}{\the\c@framenumber}{\the\c@page}}%
      \fi
    \fi
  \fi}
\newcommand{\dase@progresscounts}{%
  \dase@current=0\relax
  \def\dase@entry##1##2##3{%
    \ifnum##2>\c@framenumber\else
      \advance\dase@current by 1\relax
    \fi}%
  \dase@entries}
\newcommand{\dase@progressdots}{%
  \begingroup
  \def\dase@previouschapter{-1}%
  \def\dase@entry##1##2##3{%
    \ifnum\dase@previouschapter<0\else
      \ifnum##1=\dase@previouschapter\else\hspace{.20cm}\fi
    \fi
    \def\dase@previouschapter{##1}%
    \def\dase@dotfill{DASEpaper}%
    \def\dase@dotedge{DASEline}%
    \def\dase@dotradius{1.3pt}%
    \ifnum##1=\dase@chapter\def\dase@dotedge{DASEpurple!55}\fi
    \ifnum##2<\c@framenumber
      \def\dase@dotfill{DASEpurple!55}%
      \def\dase@dotedge{DASEpurple!55}%
    \fi
    \ifnum##2=\c@framenumber
      \def\dase@dotfill{DASEorange}%
      \def\dase@dotedge{DASEorange}%
      \def\dase@dotradius{1.8pt}%
    \fi
    \hyperlink{Navigation##3}{%
      \tikz[baseline=-.5ex]{%
        \path[use as bounding box] (-.11cm,-2.1pt) rectangle (.11cm,2.1pt);
        \draw[fill=\dase@dotfill,draw=\dase@dotedge,line width=.4pt]
          (0,0) circle (\dase@dotradius);}}}%
  \sbox{\dase@dotsbox}{\dase@entries}%
  \ifdim\wd\dase@dotsbox>.23\paperwidth
    \resizebox{.23\paperwidth}{!}{\usebox{\dase@dotsbox}}%
  \else\usebox{\dase@dotsbox}\fi
  \endgroup}

\defbeamertemplate*{footline}{DASE}{%
  \leavevmode
  \dase@progresscounts
  \begin{beamercolorbox}[wd=\paperwidth,ht=.30cm,dp=.13cm,leftskip=.78cm,rightskip=.78cm]{author in head/foot}%
    \usebeamerfont{footline}%
    \hbox to \dimexpr\paperwidth-1.56cm\relax{%
      \makebox[.30\paperwidth][l]{%
        \daseellipsis{.26\paperwidth}{%
          \insertshortauthor
          \ifx\insertshortinstitute\@empty\else
            \hspace{.55em}{\color{DASEline}\textbar}\hspace{.55em}\insertshortinstitute
          \fi}}%
      \dase@progressdots
      \hspace{.20cm}%
      \daseellipsis{.32\paperwidth}{%
        \secname}%
      \hfil
      \the\dase@current}%
  \end{beamercolorbox}%
}

\defbeamertemplate*{title page}{DASE}{%
  \begin{tikzpicture}[remember picture,overlay]
    \dasecover
    \node[opacity=.10,anchor=center] at ([xshift=.76\paperwidth,yshift=-.54\paperheight]current page.north west) {\dasewatermarklight};
    \dasebranding
    % Cover fields allow four lines while keeping the author and date clear.
    \node[anchor=west,text width=.55\paperwidth,align=left] at ([xshift=.415\paperwidth,yshift=.17\paperheight]current page.west) {\usebeamerfont{title}\color{white}\daseboundedtext[4]{.55\paperwidth}{\inserttitle}};
    \node[anchor=north west,text width=.54\paperwidth,align=left] at ([xshift=.415\paperwidth,yshift=-.51\paperheight]current page.north west) {\usebeamerfont{subtitle}\color{white!82}\daseboundedtext[4]{.54\paperwidth}{\insertsubtitle}};
    \node[anchor=south west] at ([xshift=.47\paperwidth,yshift=.9cm]current page.south west) {\usebeamerfont{author}\color{white}\daseellipsis{.25\paperwidth}{\insertauthor}};
    \node[anchor=south east] at ([xshift=-.78cm,yshift=.9cm]current page.south east) {\usebeamerfont{date}\color{white!82}\daseellipsis{.20\paperwidth}{\insertdate}};
  \end{tikzpicture}%
  \strut
}

\newcommand{\dasethankyou}[2][Thank you]{%
  \begin{tikzpicture}[remember picture,overlay]
    \dasecover
    \node[opacity=.10,anchor=center] at ([xshift=.76\paperwidth,yshift=-.54\paperheight]current page.north west) {\dasewatermarklight};
    \dasebranding
    % Closing fields are shorter by design: four lines leave breathing room for
    % the watermark and the final message.
    \node[anchor=west,text=white,text width=.55\paperwidth,align=left,font=\sffamily\bfseries\fontsize{30}{34}\selectfont] at ([xshift=.415\paperwidth,yshift=.20\paperheight]current page.west) {\daseboundedtext[4]{.55\paperwidth}{#1}};
    \node[anchor=north west,align=left,text=white!82,text width=.5\paperwidth,font=\sffamily\large] at ([xshift=.415\paperwidth,yshift=-.63\paperheight]current page.north west) {\daseboundedtext[4]{.5\paperwidth}{#2}};
  \end{tikzpicture}\strut}

\defbeamertemplate*{section page}{DASE}{%
  \begin{tikzpicture}[remember picture,overlay]
    \dasesectionbackground
    \node[opacity=.09,anchor=center] at ([xshift=.76\paperwidth,yshift=-.54\paperheight]current page.north west) {\dasewatermark};
    \dasebranding
    \node[anchor=west,text=HKUink,font=\sffamily\bfseries\fontsize{24}{29}\selectfont] (dasesectiontitle) at ([xshift=.48\paperwidth,yshift=.02\paperheight]current page.west) {\dasechaptertext{.49\paperwidth}{\secname}};
    % Follow the title's vertical centre for any visible line count, up to eight.
    \node[anchor=west,text=DASEpurple,font=\sffamily\bfseries\fontsize{28}{32}\selectfont] at ([xshift=-.065\paperwidth]dasesectiontitle.west) {\insertsectionnumber};
    % Leave room above the caption for an eight-line title at the original size.
    \node[anchor=south west,text=DASEslate,font=\sffamily\fontsize{8}{10}\selectfont] at ([xshift=.415\paperwidth,yshift=.30cm]current page.south west) {DASE / HKU SCHOOL OF ENGINEERING};
  \end{tikzpicture}%
  \strut
}

\setbeamertemplate{title}{\inserttitle}
\setbeamertemplate{title page}[DASE]
\setbeamertemplate{section page}[DASE]
\setbeamertemplate{frametitle}[DASE]
